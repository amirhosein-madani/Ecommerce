{% block subject %}
🔐 ورود جدید به حساب کاربری شما در {{ site_name }}
{% endblock %}

{% block html %}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ورود جدید</title>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;700;900&display=swap" rel="stylesheet">
</head>
<body style="margin:0;padding:0;background:linear-gradient(135deg, #f0f4ff 0%, #e8eeff 100%);font-family:'Vazirmatn',Tahoma,Arial,sans-serif;">

<table width="100%" cellpadding="0" cellspacing="0" style="padding:60px 20px;">
<tr>
<td align="center">

<table width="560" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:20px;overflow:hidden;box-shadow:0 20px 60px rgba(37,99,235,0.1);">

    <!-- Header -->
    <tr>
        <td style="background:linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);padding:45px 30px;text-align:center;">
            <div style="background:rgba(255,255,255,0.15);width:70px;height:70px;border-radius:50%;display:inline-block;margin-bottom:20px;line-height:70px;font-size:36px;">
                🔐
            </div>

            <h1 style="margin:0;color:#fff;font-size:32px;font-weight:900;">
                ورود جدید ثبت شد
            </h1>

            <p style="margin:10px 0 0;color:rgba(255,255,255,.9);font-size:15px;">
                یک ورود جدید به حساب کاربری‌تان در {{ site_name }} انجام شد.
            </p>
        </td>
    </tr>

    <!-- Content -->
    <tr>
        <td style="padding:40px 35px;">

            <p style="font-size:18px;color:#1e293b;font-weight:700;margin:0 0 20px;">
                سلام {{ username }} عزیز 👋
            </p>

            <p style="font-size:15px;color:#475569;line-height:2;margin:0 0 20px;">
                برای اطلاع شما، همین الان یک ورود جدید به حساب کاربری‌تان در
                <strong style="color:#1e40af;">{{ site_name }}</strong>
                ثبت شد.
            </p>

            <div style="
                background:#f8fafc;
                border:2px solid #e2e8f0;
                border-radius:12px;
                padding:20px;
                margin:30px 0;
            ">
                <strong style="display:block;color:#0f172a;margin-bottom:12px;">
                    جزئیات ورود
                </strong>

                <p style="margin:8px 0;color:#475569;">
                    <strong>نام کاربری:</strong>
                    {{ username }}
                </p>

                <p style="margin:8px 0;color:#475569;">
                    <strong>ایمیل:</strong>
                    {{ email }}
                </p>
            </div>

            <div style="
                background:#fef2f2;
                border:1px solid #fecaca;
                border-radius:12px;
                padding:20px;
            ">
                <strong style="display:block;color:#b91c1c;margin-bottom:10px;">
                    ⚠️ این ورود از طرف شما نبوده؟
                </strong>

                <p style="margin:0;color:#475569;line-height:2;">
                    اگر شما این ورود را انجام نداده‌اید، پیشنهاد می‌کنیم فوراً رمز عبور خود را تغییر دهید.
                </p>
            </div>

        </td>
    </tr>

    <!-- Footer -->
    <tr>
        <td style="background:linear-gradient(135deg,#1e293b 0%,#0f172a 100%);padding:25px;text-align:center;">

            <p style="margin:0 0 8px;color:#94a3b8;font-size:12px;">
                📧 این یک ایمیل خودکار است، لطفاً به آن پاسخ ندهید.
            </p>

            <p style="margin:0;color:#64748b;font-size:11px;">
                © ۲۰۲۶ {{ site_name }} | تمامی حقوق محفوظ است
            </p>

        </td>
    </tr>

</table>

</td>
</tr>
</table>

</body>
</html>
{% endblock %}

{% block plain %}
🔐 ورود جدید به حساب کاربری شما در {{ site_name }}

سلام {{ username }} عزیز،

یک ورود جدید به حساب کاربری‌تان در {{ site_name }} ثبت شد.

نام کاربری: {{ username }}
ایمیل: {{ email }}

اگر این ورود از طرف شما نبوده، لطفاً فوراً رمز عبورتان را تغییر دهید.

---
{{ site_name }} © ۲۰۲۶
{% endblock %}